# ---- Required in production (Railway → Variables). Generate values with:  npm run secrets ----
# First admin password (only read when the database is created). Min 10 chars; the app refuses to start in production without it.
ADMIN_PASSWORD=
# Admin login name (optional, default "admin"). Read on every start, so you can change it any time.
ADMIN_USERNAME=
# Long random string used to sign sessions.
SESSION_SECRET=

# ---- Railway volume ----
# Mount a Volume at /data on the service. The Dockerfile already sets PETALYA_DATA_DIR=/data.
# PETALYA_DATA_DIR=/data

# ---- Optional ----
# Client-IP trust (rate limits and login lockouts use it). Visitors can send any x-forwarded-for / x-real-ip
# they like, so only the part written by YOUR proxies is believed.
#   TRUSTED_PROXY_HOPS  number of reverse proxies in front of the app. Default in production: 1 (Railway).
#                       Use 2 if Cloudflare (or another CDN) sits in front of Railway. 0 = trust no header.
#   TRUSTED_IP_HEADER   use a single header instead of x-forwarded-for (e.g. x-real-ip). Only after you have
#                       verified that your proxy OVERWRITES it; otherwise leave unset.
# TRUSTED_PROXY_HOPS=1
# TRUSTED_IP_HEADER=
# Public address. On Railway RAILWAY_PUBLIC_DOMAIN is used automatically; set this when you add a custom domain.
# APP_URL=https://petalya.com
# Google sign-in for customers (redirect URI: <APP_URL>/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Order alerts on the phone (Web Push). Optional: keys are generated automatically and stored in the database.
# Generate your own with:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ---- Storage limits (all optional; the defaults are safe for a small shop) ----
# Customer reference photos (public upload): unused ones are deleted after this many days; total allowed on disk.
# REF_UPLOAD_MAX_AGE_DAYS=14
# REF_UPLOAD_QUOTA_MB=300
# Analytics events (events.jsonl): older than this are dropped; hard size ceiling (oldest dropped first when reached).
# About 110 bytes per event, so 50 MB holds roughly 450,000 events (~180 days at ~600 visits a day). Raise it if the
# dashboard's long-range history looks cut short, lower it if the server's memory is tight (the dashboard reads the
# whole window on every view).
# EVENTS_RETENTION_DAYS=180
# EVENTS_MAX_MB=50
# How often the lazy clean-up may run.
# MAINTENANCE_INTERVAL_SECONDS=3600
