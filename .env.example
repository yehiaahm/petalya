# ---- Required in production (Railway → Variables). Generate values with:  npm run secrets ----
# First admin password (only read when the database is created). Min 10 chars; the app refuses to start in production without it.
ADMIN_PASSWORD=
# Admin login name (optional, default "admin"). Read on every start, so you can change it any time.
ADMIN_USERNAME=
# Long random string used to sign sessions.
SESSION_SECRET=

# ---- Railway volume ----
# Mount a Volume at /data on the service. The Dockerfile already sets PETALYA_DATA_DIR=/data.
# PETALYA_DATA_DIR=/data

# ---- Optional ----
# Public address. On Railway RAILWAY_PUBLIC_DOMAIN is used automatically; set this when you add a custom domain.
# APP_URL=https://petalya.com
# Google sign-in for customers (redirect URI: <APP_URL>/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Order alerts on the phone (Web Push). Optional: keys are generated automatically and stored in the database.
# Generate your own with:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
